{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BPG Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "name",
    "summary",
    "version",
    "capabilities",
    "inputs",
    "outputs",
    "steps",
    "defaults",
    "failure_policy",
    "tradeoffs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^bpg\\.[a-z0-9_.-]+$"
    },
    "type": {
      "const": "recipe"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "additionalProperties": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "select"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "select": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "capability": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "node": {
                "type": "string",
                "pattern": "^bpg\\.[a-z0-9_.-]+$"
              },
              "preferred_node": {
                "type": "string",
                "pattern": "^bpg\\.[a-z0-9_.-]+$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "oneOf": [
              {
                "required": ["capability"],
                "not": {
                  "required": ["node"]
                }
              },
              {
                "required": ["node"],
                "not": {
                  "required": ["capability"]
                }
              }
            ]
          },
          "with": {
            "type": "object",
            "additionalProperties": true
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": true
    },
    "failure_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
