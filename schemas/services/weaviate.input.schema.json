{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "host": {
      "minLength": 1,
      "type": "string"
    },
    "port": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "scheme": {
      "enum": [
        "http",
        "https"
      ],
      "type": "string"
    }
  },
  "required": [
    "host",
    "port"
  ],
  "title": "Weaviate Service Input",
  "type": "object"
}
