{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BPG Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "summary",
    "capabilities",
    "rules",
    "compatibility",
    "trust"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^bpg\\.[a-z0-9_.-]+$"
    },
    "name": {"type": "string", "minLength": 1},
    "type": {"const": "policy"},
    "summary": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bpg"],
      "properties": {
        "bpg": {"type": "string", "minLength": 1}
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["community", "verified", "blessed", "deprecated"]
        }
      }
    }
  }
}
