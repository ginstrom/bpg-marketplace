{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "optional": {"type": "boolean"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_network", "resources", "required_secrets", "required_services"],
      "properties": {
        "requires_network": {"type": "boolean"},
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {"type": "string", "minLength": 1},
            "memory": {"type": "string", "minLength": 1},
            "timeout_seconds": {"type": "integer", "minimum": 1}
          }
        },
        "required_secrets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "required_services": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "io": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_schema", "output_schema"],
      "properties": {
        "input_schema": {"type": "string", "minLength": 1},
        "output_schema": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["temporal_activity", "service_container", "external_service"]
        },
        "language": {"type": "string", "minLength": 1},
        "entrypoint": {"type": "string", "minLength": 1},
        "task_queue": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {"const": "temporal_activity"}
            },
            "required": ["type"]
          },
          "then": {
            "required": ["language", "entrypoint"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {"const": "service_container"}
            },
            "required": ["type"]
          },
          "then": {
            "required": ["image"]
          }
        }
      ]
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "install_mode"],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "install_mode": {
          "type": "string",
          "enum": ["package", "container", "external"]
        },
        "task_queue": {"type": "string", "minLength": 1}
      }
    }
  },
  "title": "BPG Node Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "package",
    "source",
    "capabilities",
    "nodes",
    "compatibility",
    "observability",
    "trust"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^bpg\\.[a-z0-9_.-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "node_package"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "install", "version"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "install": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo"],
      "properties": {
        "repo": {"type": "string", "format": "uri"},
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "url"],
            "properties": {
              "type": {"type": "string", "enum": ["git", "oci", "pypi", "archive"]},
              "url": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "worker": {"$ref": "#/$defs/worker"},
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "python": {
          "type": "array",
          "items": {"$ref": "#/$defs/dependency"}
        },
        "system": {
          "type": "array",
          "items": {"$ref": "#/$defs/dependency"}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "capabilities",
          "runtime",
          "io",
          "retryable",
          "idempotent",
          "side_effects",
          "execution"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true
          },
          "runtime": {"$ref": "#/$defs/runtime"},
          "io": {"$ref": "#/$defs/io"},
          "retryable": {"type": "boolean"},
          "idempotent": {"type": "boolean"},
          "side_effects": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "execution": {"$ref": "#/$defs/execution"},
          "worker": {"$ref": "#/$defs/worker"}
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bpg"],
      "properties": {
        "bpg": {"type": "string", "minLength": 1}
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traces", "metrics"],
      "properties": {
        "traces": {"type": "boolean"},
        "metrics": {"type": "boolean"}
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["community", "verified", "blessed", "deprecated"]
        }
      }
    }
  }
}
