{
  "capabilities": [
    "agent",
    "human_in_the_loop"
  ],
  "compatibility": {
    "bpg": ">=0.1.0"
  },
  "dependencies": {
    "python": [
      {
        "name": "bpg-nodes-human",
        "version": "0.1.0"
      }
    ]
  },
  "id": "bpg.nodes.human",
  "name": "BPG Human Nodes",
